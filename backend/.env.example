# Fact Knowledge Layer — Environment Configuration
# Copy this file to .env and add your keys

# ── Multi-Key Provider Pool (Recommended: 5x throughput, zero 429 errors) ──
# Comma-separated list of your 5 free-tier Gemini API keys:
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5

# ── Alternatively, numbered individual keys ──
# GEMINI_API_KEY_1=your_key_1
# GEMINI_API_KEY_2=your_key_2
# GEMINI_API_KEY_3=your_key_3
# GEMINI_API_KEY_4=your_key_4
# GEMINI_API_KEY_5=your_key_5

# ── Single Key Fallback ──
# GEMINI_API_KEY=your_single_key_here
